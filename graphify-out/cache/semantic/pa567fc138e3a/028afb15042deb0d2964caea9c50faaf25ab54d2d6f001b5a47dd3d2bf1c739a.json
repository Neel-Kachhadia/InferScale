{"nodes": [{"id": "docs_benchmark_methodology_open_loop_arrivals", "label": "Coordinated-omission-safe arrivals", "file_type": "rationale", "source_file": "docs/BENCHMARK_METHODOLOGY.md", "source_location": "docs/BENCHMARK_METHODOLOGY.md:3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Precomputed open arrivals cannot depend on completions; lateness >100 ms or any recorder drop invalidates the run."}, {"id": "docs_benchmark_methodology_client_clock_latency", "label": "Client-clock latency contract", "file_type": "concept", "source_file": "docs/BENCHMARK_METHODOLOGY.md", "source_location": "docs/BENCHMARK_METHODOLOGY.md:5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All clocks are client perf_counter_ns; primary TTFT/E2E from intended arrival includes queueing; never subtract cross-process timestamps."}, {"id": "docs_benchmark_methodology_slo_goodput", "label": "SLO goodput denominator", "file_type": "concept", "source_file": "docs/BENCHMARK_METHODOLOGY.md", "source_location": "docs/BENCHMARK_METHODOLOGY.md:9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All SLO-labeled failures count as misses; only successful slo_met responses count; divide by run wall time through completion drain."}, {"id": "docs_benchmark_methodology_complete_valid_pairs", "label": "Complete valid paired treatment gate", "file_type": "rationale", "source_file": "docs/BENCHMARK_METHODOLOGY.md", "source_location": "docs/BENCHMARK_METHODOLOGY.md:11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact planned arms must share workload, rate, trial, seed and resolved configuration; singleton cannot be comparison eligible."}, {"id": "docs_benchmark_methodology_paired_trial_bootstrap", "label": "Paired trial bootstrap", "file_type": "concept", "source_file": "docs/BENCHMARK_METHODOLOGY.md", "source_location": "docs/BENCHMARK_METHODOLOGY.md:24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent trial effects are resampling units, 20000 resamples, minimum seven pairs; nominal 95% intervals do not establish coverage at small N."}, {"id": "docs_benchmark_methodology_headline_p99_population", "label": "Headline p99 population gate", "file_type": "concept", "source_file": "docs/BENCHMARK_METHODOLOGY.md", "source_location": "docs/BENCHMARK_METHODOLOGY.md:30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At least 10000 successful interactive TTFT observations per arm; per-trial p99 summarized across trials."}, {"id": "docs_benchmark_methodology_gpu_validity", "label": "Thermal and power validity gates", "file_type": "concept", "source_file": "docs/BENCHMARK_METHODOLOGY.md", "source_location": "docs/BENCHMARK_METHODOLOGY.md:38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Start <=65 C; paired spread <=5 C; stop at 85 C or thermal slowdown; >=90% successful GPU rows; power limit must equal driver default and remain constant in every sample."}, {"id": "docs_benchmark_methodology_protocol_provenance", "label": "Protocol provenance limitations", "file_type": "concept", "source_file": "docs/BENCHMARK_METHODOLOGY.md", "source_location": "docs/BENCHMARK_METHODOLOGY.md:58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Intent files were locally timestamped before runs but unsigned; post-run hashes prove integrity from indexing onward, not independent preregistration."}, {"id": "docs_benchmark_methodology_future_campaign", "label": "Future publication campaign", "file_type": "rationale", "source_file": "docs/BENCHMARK_METHODOLOGY.md", "source_location": "docs/BENCHMARK_METHODOLOGY.md:64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Better-cooled host, inde